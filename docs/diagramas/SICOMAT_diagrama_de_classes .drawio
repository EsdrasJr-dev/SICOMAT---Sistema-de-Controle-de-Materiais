;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1760" y="1070" width="400" height="214" as="geometry" /></mxCell><mxCell id="c_item_a0" value="- numeroPatrimonio: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="26" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_a1" value="- status: StatusItem" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="46" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_item"><mxGeometry y="66" width="400" height="8" as="geometry" /></mxCell><mxCell id="c_item_m0" value="+ estaDisponivel(): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="74" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_m1" value="+ empenhar(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="94" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_m2" value="+ devolver(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="114" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_m3" value="+ marcarExtraviado(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="134" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_m5" value="+ marcarAvariado(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="154" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_m6" value="+ liberar(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="174" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_item_m4" value="+ inativar(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_item"><mxGeometry y="194" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_status_item" value="&amp;lt;&amp;lt;enum&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;StatusItem&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1760" y="1340" width="400" height="140" as="geometry" /></mxCell><mxCell id="c_status_item_a0" value="DISPONIVEL" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_status_item"><mxGeometry y="40" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_status_item_a1" value="EMPENHADO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_status_item"><mxGeometry y="60" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_status_item_a2" value="AVARIADO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_status_item"><mxGeometry y="80" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_status_item_a3" value="EXTRAVIADO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_status_item"><mxGeometry y="100" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_status_item_a4" value="INATIVO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_status_item"><mxGeometry y="120" width="400" height="20" as="geometry" /></mxCell><mxCell id="n_perfis" value="Regra de perfis: o OPERADOR só monta, confirma ou cancela empenhos e recebe devoluções. O ADMINISTRADOR DE ESTOQUE cadastra materiais, itens e recebedores e resolve exceções (extravio, item avariado). O ADMINISTRADOR DO SISTEMA só gerencia contas de usuário e não mexe no estoque. Materiais, itens e usuários são inativados, nunca excluídos." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;size=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="200" height="230" as="geometry" /></mxCell><mxCell id="n_rastro" value="Rastreabilidade: todo Empenho e toda Devolucao guardam quem registrou (operador) e quando (dataHora). O Empenho guarda com quem os itens ficaram (equipe + recebedor); a Devolucao guarda quem devolveu (devolvido por). Cada ItemDevolucao registra a condição do item devolvido." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;size=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="320" height="130" as="geometry" /></mxCell><mxCell id="n_fluxo" value="Fluxo: o operador monta a lista (itens + patrimônio) e o Empenho nasce PENDENTE, com um ItemEmpenho por item. Ao CONFIRMAR, o recebedor é verificado e os itens ficam EMPENHADOS (MVP: confirmação facial; PIN como exceção justificada quando a facial falhar ou estiver indisponível). Ao CANCELAR, o Empenho vira CANCELADO e o estoque não muda. Na devolução, cada ItemDevolucao fecha um ItemEmpenho e registra quem devolveu e a condição; item AVARIADO só volta a DISPONIVEL quando o administrador liberar." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;size=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500" y="1490" width="640" height="140" as="geometry" /></mxCell><mxCell id="c_cond_item" value="&amp;lt;&amp;lt;enum&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;CondicaoItem&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1290" y="740" width="320" height="80" as="geometry" /></mxCell><mxCell id="c_cond_item_v0" value="BOM" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_cond_item"><mxGeometry y="40" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_cond_item_v1" value="AVARIADO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_cond_item"><mxGeometry y="60" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itemdev" value="&lt;b&gt;ItemDevolucao&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1290" y="876" width="320" height="114" as="geometry" /></mxCell><mxCell id="c_itemdev_r0" value="- condicao: CondicaoItem" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itemdev"><mxGeometry y="26" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itemdev_r1" value="- observacao: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itemdev"><mxGeometry y="46" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itemdev_r2" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_itemdev"><mxGeometry y="66" width="320" height="8" as="geometry" /></mxCell><mxCell id="c_itemdev_r3" value="+ estaAvariado(): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itemdev"><mxGeometry y="74" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itemdev_r4" value="+ getItemEmpenho(): ItemEmpenho" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itemdev"><mxGeometry y="94" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itememp" value="&lt;b&gt;ItemEmpenho&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1290" y="1060" width="320" height="114" as="geometry" /></mxCell><mxCell id="c_itememp_r0" value="- situacao: SituacaoItemEmpenho" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itememp"><mxGeometry y="26" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itememp_r1" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_itememp"><mxGeometry y="46" width="320" height="8" as="geometry" /></mxCell><mxCell id="c_itememp_r2" value="+ marcarDevolvido(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itememp"><mxGeometry y="54" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itememp_r3" value="+ marcarExtraviado(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itememp"><mxGeometry y="74" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_itememp_r4" value="+ estaPendente(): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_itememp"><mxGeometry y="94" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_sit_item" value="&amp;lt;&amp;lt;enum&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SituacaoItemEmpenho&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1290" y="1220" width="320" height="100" as="geometry" /></mxCell><mxCell id="c_sit_item_v0" value="EMPENHADO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_sit_item"><mxGeometry y="40" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_sit_item_v1" value="DEVOLVIDO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_sit_item"><mxGeometry y="60" width="320" height="20" as="geometry" /></mxCell><mxCell id="c_sit_item_v2" value="EXTRAVIADO" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_sit_item"><mxGeometry y="80" width="320" height="20" as="geometry" /></mxCell><mxCell id="n_itemassoc" value="ItemEmpenho e ItemDevolucao (substituem a ItemMovimentacao da v3): o ItemEmpenho é a linha de cada item dentro de um Empenho e guarda a situação dele. O ItemDevolucao fecha exatamente um ItemEmpenho e registra a condição na volta (BOM ou AVARIADO). Regra: uma Devolucao só pode referenciar itens do mesmo Empenho." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;size=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1290" y="1370" width="320" height="170" as="geometry" /></mxCell><mxCell id="n_estados" value="Ciclo do Empenho: PENDENTE → ABERTO (confirmação do recebedor) → DEVOLVIDO_PARCIALMENTE (alguns itens devolvidos) → ENCERRADO (nenhum item pendente). PENDENTE → CANCELADO (cancelado antes de confirmar). EXTRAVIADO = nenhum item pendente, mas ao menos um item extraviado. O status é calculado a partir da situação dos ItemEmpenho." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;size=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="330" height="170" as="geometry" /></mxCell><mxCell id="c_adminsis" value="&lt;b&gt;AdministradorSistema&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontSize=13;fillColor=#b0e3e6;strokeColor=#0e8088;swimlaneFillColor=#FFFFFF;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1270" y="330" width="400" height="174" as="geometry" /></mxCell><mxCell id="c_adminsis_a0" value="- setor: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_adminsis"><mxGeometry y="26" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_adminsis_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="c_adminsis"><mxGeometry y="46" width="400" height="8" as="geometry" /></mxCell><mxCell id="c_adminsis_m0" value="+ cadastrarUsuario(usuario: Usuario): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="c_adminsis"><mxGeometry y="54" width="400" height="20" as="geometry" /></mxCell><mxCell id="c_adminsis_m1" value="+ inativarUsuario(usuario: Usuario): void" style="text;strokeC